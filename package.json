{
  "name": "instagram-automation-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:mcp": "node --experimental-strip-types scripts/mcp-smoke.mts",
    "verify:deployment": "node --experimental-strip-types scripts/verify-deployment.mts",
    "dev": "wrangler dev --config wrangler.local.jsonc",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:integration": "node --experimental-strip-types --test tests/*.integration.mts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.mts",
    "deploy": "wrangler deploy --config wrangler.local.jsonc",
    "credentials:bootstrap": "node --experimental-strip-types scripts/bootstrap-credentials.mts",
    "config:init": "node --experimental-strip-types scripts/init-config.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@neondatabase/serverless": "1.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20261012.1-beta",
    "typescript": "^5.9.2",
    "wrangler": "4.151.1"
  },
  "description": "Self-hosted Instagram comment-to-DM automation controlled through MCP",
  "license": "MIT",
  "author": "Vini Pace",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinipace/instagram-automation-mcp.git"
  },
  "homepage": "https://github.com/vinipace/instagram-automation-mcp#readme",
  "bugs": {
    "url": "https://github.com/vinipace/instagram-automation-mcp/issues"
  }
}
